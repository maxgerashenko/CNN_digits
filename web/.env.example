# Address of the training server (the Hugging Face Space), without a slash at the end.
# Copy this file to .env.local and fill it in. Leave it empty to run without training.
VITE_TRAINING_SERVER_URL=

# Google Tag Manager container ID, like GTM-XXXXXXX. Empty uses the project's container
# (GTM-5W55NZQZ); "off" loads nothing.
VITE_GTM_ID=
